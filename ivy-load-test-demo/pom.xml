<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.axonivy.utils.loadtest</groupId>
  <artifactId>ivy-load-test-demo</artifactId>
  <version>13.2.1</version>
  <properties>
    <maven.compiler.source>21</maven.compiler.source>
    <maven.compiler.target>21</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Let a reactor-wide -Dtest=... filter target a single module: modules without a
         matching test report "No tests to run" instead of failing the whole build. -->
    <surefire.failIfNoSpecifiedTests>false</surefire.failIfNoSpecifiedTests>
  </properties>
  <dependencies>
    <!-- Generic, fluent JSF/Ivy load-test building blocks (hides ViewState/AJAX correlation). -->
    <dependency>
      <groupId>com.axonivy.utils.loadtest</groupId>
      <artifactId>ivy-load-test</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-engine</artifactId>
      <version>6.0.3</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>3.27.7</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-launcher</artifactId>
      <version>6.0.3</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>us.abstracta.jmeter</groupId>
      <artifactId>jmeter-java-dsl-jmx2dsl</artifactId>
      <version>1.8</version>
    </dependency>
  
  </dependencies>
  <build>
    <testSourceDirectory>src_test</testSourceDirectory>
    <plugins>
      <!-- We force to use the latest version of surefire plugin to properly run junit5 tests -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.5</version>
        <configuration>
          <excludes>
            <!-- Requires a running Portal server - execute locally only -->
            <exclude>**/PortalWalkthroughLoadTest.java</exclude>
            <!-- Template skeleton, requires a running Portal server - execute locally only -->
            <exclude>**/LoadTestTemplate.java</exclude>
          </excludes>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.15.0</version>
      </plugin>
    </plugins>

  </build>

  <profiles>
    <!-- Activate with -Plocal-portal to run the Portal walkthrough tests locally. -->
    <profile>
      <id>local-portal</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <excludes combine.self="override" />
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
